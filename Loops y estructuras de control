print("--- 1. Números del 1 al 10 ---")
for i in range(1, 11):
    print(i)

print("\n--- 2. Números pares entre 0 y 20 ---")
for i in range(0, 21, 2):
    print(i)

print("\n--- 3. Suma de los números del 1 al 5 ---")
suma = sum(range(1, 6))
print("El resultado final es:", suma)

print("\n--- 4. Cuenta regresiva ---")
numero = int(input("Ingresa un número para la cuenta regresiva: "))
for i in range(numero, -1, -1):
    print(i)

print("\n--- 5. Validación de contraseña ---")
contrasena = ""
while contrasena != "python123":
    contrasena = input("Ingresa la contraseña: ")
print("Acceso concedido")

print("\n--- 6. Suma total y promedio de 5 números ---")
suma_numeros = 0
for i in range(5):
    num = float(input(f"Ingresa el número {i + 1}: "))
    suma_numeros += num
promedio = suma_numeros / 5
print(f"Suma total: {suma_numeros}")
print(f"Promedio: {promedio}")

print("\n--- 7. Número mayor entre 4 números ---")
mayor = None
for i in range(4):
    num = float(input(f"Ingresa el número {i + 1}: "))
    if mayor is None or num > mayor:
        mayor = num
print(f"El número mayor es: {mayor}")

print("\n--- 8. Patrón de asteriscos ---")
for i in range(1, 6):
    print("*" * i)

print("\n--- 9. Contar vocales y consonantes ---")
palabra = input("Ingresa una palabra: ").lower()
vocales = "aeiou"
contador_vocales = 0
contador_consonantes = 0
for letra in palabra:
    if letra.isalpha():
        if letra in vocales:
            contador_vocales += 1
        else:
            contador_consonantes += 1
print(f"Cantidad de vocales: {contador_vocales}")
print(f"Cantidad de consonantes: {contador_consonantes}")

print("\n--- 10. Tablas de multiplicar del 1 al 5 ---")
for i in range(1, 11):
    fila = ""
    for j in range(1, 6):
        fila += f"{j} x {i} = {j * i}\t"
    print(fila)
