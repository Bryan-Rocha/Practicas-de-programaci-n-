if __name__ == "__main__":
    print("=== PROGRAMA DE CIFRADO CÉSAR ===")
    
    # 1. Pide al usuario un mensaje a cifrar
    mensaje_usuario = input("Introduce el mensaje a cifrar: ")
    
    # 2. Pide el desplazamiento con validación (entre 1 y 25)
    desplazamiento_usuario = 0
    while desplazamiento_usuario < 1 or desplazamiento_usuario > 25:
        try:
            desplazamiento_usuario = int(input("Introduce el desplazamiento (número entre 1 y 25): "))
            if desplazamiento_usuario < 1 or desplazamiento_usuario > 25:
                print("Error: El desplazamiento debe estar estrictamente entre 1 y 25.")
        except ValueError:
            print("Error: Por favor, introduce un número entero válido.")
            
    # 3. Muestra el mensaje cifrado
    mensaje_resultado_cifrado = cifrar_mensaje(mensaje_usuario, desplazamiento_usuario)
    print(f"\nMensaje original: {mensaje_usuario}")
    print(f"Mensaje cifrado:  {mensaje_resultado_cifrado}")
    
    # 4. Descifra el mensaje y muestra el resultado original para verificar
    # Para descifrar un Cifrado César, basta con aplicar el desplazamiento inverso (26 - desplazamiento)
    desplazamiento_inverso = 26 - desplazamiento_usuario
    mensaje_descifrado = cifrar_mensaje(mensaje_resultado_cifrado, desplazamiento_inverso)
    print(f"Mensaje descifrado (verificación): {mensaje_descifrado}")
