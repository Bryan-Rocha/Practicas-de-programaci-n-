def cifrar_letra(letra, desplazamiento):
    """
    Cifra una sola letra mayúscula usando el Cifrado César.
    - letra: un carácter (A-Z)
    - desplazamiento: número entero de posiciones a desplazar
    """
    # Verificamos si es una letra mayúscula
    if 'A' <= letra <= 'Z':
        # Convertimos la letra a su código ASCII
        codigo_actual = ord(letra)
        # Aplicamos el desplazamiento y aseguramos que permanezca en el rango del alfabeto (A-Z: 65-90)
        # Restamos 65 para trabajar con base 0 (A=0, Z=25), sumamos el desplazamiento y aplicamos módulo 26
        codigo_cifrado = ((codigo_actual - 65 + desplazamiento) % 26) + 65
        return chr(codigo_cifrado)
    
    # Si no es una letra mayúscula, se devuelve tal cual (aunque en este ejercicio se filtrará antes)
    return letra


def cifrar_mensaje(mensaje, desplazamiento):
    """
    Cifra un mensaje completo utilizando la función cifrar_letra.
    - Cifra SOLO las letras (A-Z), ignorando espacios, números y puntuación.
    - Convierte automáticamente el mensaje a mayúsculas.
    """
    mensaje_mayus = mensaje.upper()
    mensaje_cifrado = ""
    
    for caracter in mensaje_mayus:
        if caracter.isalpha():
            # Si es una letra, la ciframos
            mensaje_cifrado += cifrar_letra(caracter, desplazamiento)
        else:
            # Si es espacio, número o signo de puntuación, lo dejamos intacto
            mensaje_cifrado += caracter
            
    return mensaje_cifrado


